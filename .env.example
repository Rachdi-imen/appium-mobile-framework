# ---------------------------------------------------------------
# Copy this file to ".env" and adjust the values.
# Never commit ".env": it may contain secrets.
# ---------------------------------------------------------------

# --- Execution ---
# android | ios
PLATFORM=android
# local | browserstack | saucelabs
EXECUTION_MODE=local
APPIUM_SERVER_URL=http://127.0.0.1:4723
EXPLICIT_WAIT_TIMEOUT=15

# --- Android (local) ---
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_APP_PATH=apps/android-mydemoapp.apk
ANDROID_APP_PACKAGE=com.saucelabs.mydemoapp.android

# --- iOS (cloud or macOS only) ---
IOS_DEVICE_NAME=iPhone 15
IOS_APP_PATH=apps/ios-mydemoapp.zip
IOS_BUNDLE_ID=com.saucelabs.mydemo.app.ios

# --- BrowserStack (only if EXECUTION_MODE=browserstack) ---
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# BROWSERSTACK_APP_URL=bs://<app-id>

# --- Sauce Labs (only if EXECUTION_MODE=saucelabs) ---
# SAUCELABS_USERNAME=
# SAUCELABS_ACCESS_KEY=
# SAUCELABS_APP=storage:filename=<app-name>.apk
# SAUCELABS_REGION=eu-central-1

# --- Observability ---
RECORD_VIDEO=true